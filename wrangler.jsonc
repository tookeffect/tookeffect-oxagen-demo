{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tookeffect-oxagen-demo",
  "main": "src/app.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "CORE_BASE_URL": "https://tookeffect.com"
  },
  "ratelimits": [
    {
      "name": "VERIFY_ACTOR_RATE_LIMITER",
      "namespace_id": "8242401",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "VERIFY_GLOBAL_RATE_LIMITER",
      "namespace_id": "8242402",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "oxagen.tookeffect.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}

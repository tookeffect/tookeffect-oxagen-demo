{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tookeffect-oxagen-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "CORE_BASE_URL": "https://tookeffect.com"
  },
  "routes": [
    {
      "pattern": "oxagen.tookeffect.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
